{
  "name": "@munimh/smtpwire",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./node": "./node.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "publish": {
    "include": [
      "mod.ts",
      "node.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "SECURITY.md"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "CHANGELOG.md"
    ]
  },
  "tasks": {
    "test": "deno test --allow-net=127.0.0.1,localhost --allow-env --allow-read test/",
    "integration": "deno test --allow-net --allow-env integration/",
    "check": "deno fmt --check && deno lint && deno check mod.ts node.ts examples/ test/ integration/ && deno doc --lint mod.ts node.ts"
  }
}
